---
layout: page
---
<div class="post">
    <article>
        {% if page.profiles %}
            <div class="profiles-container">
            {% for profile in page.profiles %}
                
                {% if profile.separator %}
                <div class="institution-separator w-100 clearfix">
                    <h2 class="text-center separator-title">{{ profile.separator }}</h2>
                </div>
                {% continue %}
                {% endif %}

                {% if profile.category == 'external' %}
                    <div class="ext-card">
                        <div class="ext-head">
                            {% if profile.image %}
                                {% assign profile_image_path = profile.image | prepend: 'assets/img/' %}
                                <img class="ext-avatar" src="{{ profile_image_path | relative_url }}" alt="{{ profile.name }}" loading="lazy">
                            {% endif %}
                            <div class="ext-id">
                                <h5 class="ext-name">{{ profile.name }}</h5>
                                {% if profile.role %}<div class="ext-role">{{ profile.role }}</div>{% endif %}
                                {% if profile.institution %}<div class="ext-inst">{{ profile.institution }}</div>{% endif %}
                            </div>
                        </div>

                        {% if profile.research_field %}
                            <div class="ext-field">
                                {% if profile.research_icon %}<i class="{{ profile.research_icon }}"></i>{% endif %}
                                <span>{{ profile.research_field }}</span>
                            </div>
                        {% endif %}

                        {% if profile.content %}
                            {% capture profile_content %}{% include_relative {{ profile.content }} %}{% endcapture %}
                            <div class="ext-bio" id="ext-bio-{{ forloop.index }}">{{ profile_content | markdownify }}</div>
                        {% endif %}

                        <div class="ext-footer">
                            <div class="ext-links">
                                {% if profile.email %}<a href="mailto:{{ profile.email }}" title="Email"><i class="fa-solid fa-envelope"></i></a>{% endif %}
                                {% if profile.website %}<a href="{{ profile.website }}" target="_blank" rel="noopener" title="Website"><i class="fa-solid fa-globe"></i></a>{% endif %}
                                {% if profile.social.linkedin %}<a href="https://www.linkedin.com/in/{{ profile.social.linkedin }}" target="_blank" rel="noopener" title="LinkedIn"><i class="fab fa-linkedin"></i></a>{% endif %}
                                {% if profile.social.scholar %}<a href="https://scholar.google.com/citations?user={{ profile.social.scholar }}" target="_blank" rel="noopener" title="Google Scholar"><i class="ai ai-google-scholar"></i></a>{% endif %}
                            </div>
                            {% if profile.content %}
                                <button type="button" class="ext-more" aria-expanded="false" aria-controls="ext-bio-{{ forloop.index }}" onclick="toggleExtBio(this)">Read more</button>
                            {% endif %}
                        </div>
                    </div>

                {% else %}
                    <div class="core-profile-block clearfix">
                        <div class="profile-header-divider"></div>
                        <div class="profile float-{% if profile.align == 'left' %}left{% else %}right{% endif %}">
                            {% if profile.image %}
                                <div class="profile-img-container">
                                    {% assign profile_image_path = profile.image | prepend: 'assets/img/' %}
                                    {% if profile.image_circular %}
                                        {% assign profile_image_class = 'img-fluid z-depth-1 rounded-circle' %}
                                    {% else %}
                                        {% assign profile_image_class = 'img-fluid z-depth-1 rounded-lg' %}
                                    {% endif %}
                                    {% capture sizes %}(min-width: {{ site.max_width }}) {{ site.max_width | minus: 30 | times: 0.3}}px, (min-width: 576px) 30vw, 95vw"{% endcapture %}
                                    {% include figure.liquid loading="eager" path=profile_image_path class=profile_image_class sizes=sizes alt=profile.image %}
                                    
                                    {% if profile.role %}
                                    <div class="role-badge">{{ profile.role }}</div>
                                    {% endif %}
                                </div>
                            {% endif %}

                            <div class="more-info shadow-sm">
                                {% if profile.email %}
                                    <div class="info-link"><i class="fa-solid fa-envelope"></i> <a href="mailto:{{ profile.email }}">{{ profile.email }}</a></div>
                                {% endif %}
                                {% if profile.email2 %}
                                    <div class="info-link"><i class="fa-solid fa-envelope"></i> <a href="mailto:{{ profile.email2 }}">{{ profile.email2 }}</a></div>
                                {% endif %}
                                {% if profile.website %}
                                    <div class="info-link"><i class="fa-solid fa-globe"></i> <a href="{{ profile.website }}" target="_blank">Website</a></div>
                                {% endif %}
                                {% if profile.social.linkedin %}
                                    <div class="info-link"><i class="fab fa-linkedin"></i> <a href="https://www.linkedin.com/in/{{ profile.social.linkedin }}" target="_blank">LinkedIn</a></div>
                                {% endif %}
                                {% if profile.social.scholar %}
                                    <div class="info-link"><i class="fas fa-graduation-cap"></i> <a href="https://scholar.google.com/citations?user={{ profile.social.scholar }}" target="_blank">Scholar</a></div>
                                {% endif %}
                                {% if profile.more_info %}
                                    <div class="more-info-details mt-2">{{ profile.more_info }}</div>
                                {% endif %}
                            </div>
                        </div>

                        <div class="bio-content">
                            {% if profile.content %}
                                {% capture profile_content %}{% include_relative {{ profile.content }} %}{% endcapture %}
                                {{ profile_content | markdownify }}
                            {% else %}
                                {{ content }}
                            {% endif %}
                        </div>
                    </div>
                {% endif %}
            {% endfor %}
            </div>
        {% endif %}
    </article>
</div>

<script>
    function toggleExtBio(btn) {
        const bio = document.getElementById(btn.getAttribute('aria-controls'));
        const open = bio.classList.toggle('is-open');
        btn.setAttribute('aria-expanded', open);
        btn.textContent = open ? 'Show less' : 'Read more';
    }
</script>

<style>
    /* CORE STYLES */
    .separator-title { font-weight: 800; text-transform: uppercase; letter-spacing: 2px; color: var(--global-theme-color); margin: 3rem 0; }
    .profile-header-divider { height: 1px; background: var(--global-divider-color); margin: 2rem 0; opacity: 0.5; }
    .core-profile-block { margin-bottom: 4rem; }
    .profile-img-container { position: relative; margin-bottom: 1rem; }
    .role-badge { position: absolute; bottom: 10px; right: 10px; background: var(--global-theme-color); color: white; padding: 2px 10px; border-radius: 5px; font-size: 0.7rem; font-weight: bold; box-shadow: 0 2px 5px rgba(0,0,0,0.2); }
    .more-info { background: var(--global-card-bg-color); border: 1px solid var(--global-divider-color); padding: 15px; border-radius: 10px; margin-top: 15px; }
    .info-link { font-size: 0.85rem; margin-bottom: 4px; display: flex; align-items: center; gap: 8px; }
    .info-link i { color: var(--global-theme-color); width: 14px; text-align: center; }

    /* EXTERNAL MEMBERS */
    .profiles-container { display: flex; flex-wrap: wrap; gap: 20px; }
    .profiles-container > .institution-separator,
    .profiles-container > .core-profile-block { flex: 0 0 100%; }
    .ext-card {
        flex: 0 0 calc(50% - 10px);
        align-self: flex-start;
        display: flex; flex-direction: column; gap: 14px;
        padding: 20px;
        background: var(--global-card-bg-color, var(--global-bg-color));
        border: 1px solid var(--global-divider-color);
        border-top: 3px solid var(--global-theme-color);
        border-radius: 12px;
        transition: box-shadow 0.2s, border-color 0.2s;
    }
    .ext-card:hover { box-shadow: 0 6px 18px rgba(0,0,0,0.08); }
    .ext-head { display: flex; align-items: center; gap: 16px; }
    .ext-avatar {
        flex: 0 0 88px; width: 88px; height: 88px;
        border-radius: 50%; object-fit: cover; object-position: center 20%;
        border: 2px solid var(--global-divider-color);
    }
    .ext-id { min-width: 0; }
    .ext-name { margin: 0 0 2px; font-weight: 700; font-size: 1.1rem; color: var(--global-text-color); }
    .ext-role { font-size: 0.85rem; font-weight: 600; color: var(--global-theme-color); }
    .ext-inst { font-size: 0.8rem; color: var(--global-text-color-light); line-height: 1.35; margin-top: 2px; }
    .ext-field {
        display: flex; align-items: center; gap: 8px;
        font-size: 0.8rem; color: var(--global-text-color);
        padding: 6px 10px; border-radius: 6px;
        background: color-mix(in srgb, var(--global-theme-color) 8%, transparent);
    }
    .ext-field i { color: var(--global-theme-color); width: 14px; text-align: center; }
    .ext-bio {
        font-size: 0.85rem; line-height: 1.55; color: var(--global-text-color);
        display: -webkit-box; -webkit-line-clamp: 4; -webkit-box-orient: vertical; overflow: hidden;
    }
    .ext-bio p { margin-bottom: 0.6em; }
    .ext-bio.is-open { display: block; -webkit-line-clamp: unset; }
    .ext-footer {
        display: flex; align-items: center; justify-content: space-between;
        margin-top: auto; padding-top: 10px; border-top: 1px solid var(--global-divider-color);
    }
    .ext-links { display: flex; gap: 14px; font-size: 1.05rem; }
    .ext-links a { color: var(--global-text-color-light); transition: color 0.15s; }
    .ext-links a:hover { color: var(--global-theme-color); }
    .ext-more {
        background: none; border: none; padding: 0; cursor: pointer;
        font-size: 0.8rem; font-weight: 600; color: var(--global-theme-color);
    }
    .ext-more:hover { text-decoration: underline; }

    /* FLOATING OVERRIDES */
    .profile.float-right { margin-left: 2rem; width: 30%; min-width: 250px; }
    .profile.float-left { margin-right: 2rem; width: 30%; min-width: 250px; }

    @media (max-width: 768px) {
        .ext-card { flex-basis: 100%; }
        .profile { float: none !important; width: 100% !important; margin: 0 0 20px 0 !important; }
    }
</style>